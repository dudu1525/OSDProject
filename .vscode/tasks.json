{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "HAL9000: Help",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "--help"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Deep clean",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "deep_clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Setup",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "setup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Configure",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "configure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Clean all",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "clean",
                "--all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Clean",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Build all",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "build",
                "--all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Build",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Run",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Run for debugging",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "run",
                "-d"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "HAL9000: Run tests",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "HAL9000.py",
                "test",
                "-t",
                "${input:testModule}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
    ],
    "inputs": [
        {
            "id": "testModule",
            "description": "Select module",
            "type": "pickString",
            "options": [
                "Threads",
                "UserProg",
                "VirtualMemory"
            ]
        }
    ]
}